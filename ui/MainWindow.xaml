<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NVIDIA Optical Flow · Newton Cost 시험판" Width="520" Height="500" MinWidth="480" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="#F6F7F5" Foreground="#222925"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#222925"/>
    <SolidColorBrush x:Key="SecondaryInk" Color="#59635D"/>
    <SolidColorBrush x:Key="Line" Color="#CCD3CD"/>
    <SolidColorBrush x:Key="Accent" Color="#216D4C"/>
    <SolidColorBrush x:Key="AccentHover" Color="#18553B"/>
    <SolidColorBrush x:Key="Selected" Color="#EAF3ED"/>
    <SolidColorBrush x:Key="Error" Color="#A12D2D"/>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Subtle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SecondaryInk}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="18"/>
    </Style>
    <Style x:Key="FocusVisual">
      <Setter Property="Control.Template">
        <Setter.Value><ControlTemplate><Border Margin="-3" BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="7"/></ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#EDF1ED"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DDE5DE"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#10462F"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RateCheck" TargetType="CheckBox">
      <Setter Property="Height" Value="30"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="FocusBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="2,3">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="Box" Width="14" Height="14" CornerRadius="2" Background="White" BorderBrush="#7D8B80" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center">
              <Path x:Name="Tick" Data="M 2,6 L 5,9 L 10,3" Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Hidden"/>
            </Border>
            <ContentPresenter VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FocusBorder" Property="Background" Value="#E8EEE9"/></Trigger>
          <Trigger Property="IsFocused" Value="True"><Setter TargetName="FocusBorder" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="14,9"/><Setter Property="Foreground" Value="{StaticResource SecondaryInk}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
          <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#E8EEE9"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
        <Grid KeyboardNavigation.TabNavigation="Local"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><TabPanel IsItemsHost="True" Margin="18,0"/></Border>
          <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="18,16,18,12"/>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MasterSwitch" TargetType="ToggleButton">
      <Setter Property="Width" Value="94"/><Setter Property="Height" Value="32"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="AutomationProperties.Name" Value="NVIDIA Optical Flow 사용"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent" Padding="6,0">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="Label" Text="꺼짐" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Border x:Name="Track" Grid.Column="1" Height="24" CornerRadius="12" Background="#717C74" VerticalAlignment="Center">
                  <Ellipse x:Name="Thumb" Fill="White" Width="16" Height="16" Margin="4" HorizontalAlignment="Left"/>
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Label" Property="Text" Value="켜짐"/><Setter TargetName="Label" Property="Foreground" Value="{StaticResource Accent}"/><Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Background="#F6F7F5">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="20,14,20,10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="프레임 보간" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <ToggleButton x:Name="EnabledToggle" Grid.Column="1" Style="{StaticResource MasterSwitch}"/>
      </Grid>
      <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#717C74" Margin="0,0,7,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusTitle" Grid.Column="1" Text="팟플레이어 연결 대기" FontSize="13" AutomationProperties.LiveSetting="Polite"/>
      </Grid>
      <TextBlock x:Name="StatusDetail" Text="필터를 연결한 뒤 영상을 재생하면 상태가 표시됩니다." Style="{StaticResource Subtle}" Margin="13,3,0,0"/>
    </StackPanel>
    <TabControl x:Name="SettingsTabs" Grid.Row="1" SelectedIndex="0" KeyboardNavigation.TabNavigation="Continue">
      <TabItem x:Name="InterpolationTab" Header="보간 설정">
        <StackPanel x:Name="InterpolationPanel" TextElement.Foreground="{StaticResource Ink}" TextElement.FontWeight="Normal">
          <TextBlock Text="보간할 원본 FPS" FontWeight="SemiBold" Margin="0,0,0,7"/>
          <UniformGrid x:Name="InputRateChoices" Rows="1" Columns="6" IsEnabled="{Binding IsChecked, ElementName=EnabledToggle}" KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="보간할 원본 프레임">
            <CheckBox x:Name="InputRate0" Content="24" Style="{StaticResource RateCheck}" ToolTip="23.976 및 24 fps" AutomationProperties.Name="원본 24 fps 보간, 23.976 포함"/>
            <CheckBox x:Name="InputRate1" Content="25" Style="{StaticResource RateCheck}" AutomationProperties.Name="원본 25 fps 보간"/>
            <CheckBox x:Name="InputRate2" Content="30" Style="{StaticResource RateCheck}" ToolTip="29.97 및 30 fps" AutomationProperties.Name="원본 30 fps 보간, 29.97 포함"/>
            <CheckBox x:Name="InputRate3" Content="50" Style="{StaticResource RateCheck}" AutomationProperties.Name="원본 50 fps 보간"/>
            <CheckBox x:Name="InputRate4" Content="60" Style="{StaticResource RateCheck}" ToolTip="59.94 및 60 fps" AutomationProperties.Name="원본 60 fps 보간, 59.94 포함"/>
            <CheckBox x:Name="InputRate5" Content="기타" Style="{StaticResource RateCheck}" ToolTip="목록에 없는 원본 FPS" AutomationProperties.Name="기타 원본 프레임 보간"/>
          </UniformGrid>
          <TextBlock x:Name="RateSelectionHint" Text="23.976·29.97·59.94 fps는 각각 24·30·60에 포함됩니다." Style="{StaticResource Subtle}" Margin="0,5,0,20"/>
          <TextBlock Text="출력 프레임" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock x:Name="OutputRateSummary" Text="×2 · 원본 프레임의 두 배" FontWeight="SemiBold"/>
          <TextBlock x:Name="OutputRateHint" Style="{StaticResource Subtle}" Margin="0,5,0,0"/>
          <TextBlock Text="원본 프레임 사이에 중간 프레임을 하나 추가합니다." Style="{StaticResource Subtle}" Margin="0,8,0,0"/>
        </StackPanel>
      </TabItem>
      <TabItem x:Name="EnhancementsTab" Header="화질 보정">
        <StackPanel TextElement.Foreground="{StaticResource Ink}" TextElement.FontWeight="Normal">
          <StackPanel x:Name="NativeEnhancementPanel" Visibility="Collapsed">
            <TextBlock Text="자동 화질 보호" FontWeight="SemiBold"/>
            <TextBlock Text="움직임이 겹치는 경계와 화면에 고정된 글자를 분석해 보간 깨짐을 줄입니다." Style="{StaticResource Subtle}" Margin="0,8,0,0"/>
            <TextBlock Text="0.3.0에서는 보간을 켜면 자동으로 적용됩니다. 예전 버전의 두 보정 옵션은 사용하지 않습니다." Style="{StaticResource Subtle}" Margin="0,12,0,0"/>
            <TextBlock Text="빠르게 변하는 머리카락이나 연기, 겹친 물체에는 잔상이 남을 수 있습니다." Style="{StaticResource Subtle}" Margin="0,12,0,0"/>
          </StackPanel>
          <StackPanel x:Name="LegacyEnhancementPanel">
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,14,0">
              <TextBlock Text="GPU 중간 프레임 보정" FontWeight="SemiBold"/>
              <TextBlock Text="느린 이동의 중간 위치와 얇은 선을 다듬습니다." Style="{StaticResource Subtle}" Margin="0,5,0,0"/>
            </StackPanel>
            <ToggleButton x:Name="GpuCorrectionToggle" Grid.Column="1" Style="{StaticResource MasterSwitch}" VerticalAlignment="Top" HorizontalAlignment="Right" IsEnabled="{Binding IsChecked, ElementName=EnabledToggle}" AutomationProperties.Name="GPU 중간 프레임 보정"/>
          </Grid>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,0,0,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,14,0">
                <TextBlock Text="형태 변화 보호" FontWeight="SemiBold"/>
                <TextBlock Text="입모양처럼 갑자기 달라지는 형태의 깨짐을 줄입니다. 화면 이동 시에는 자동으로 보호를 줄입니다." Style="{StaticResource Subtle}" Margin="0,5,0,0"/>
              </StackPanel>
              <ToggleButton x:Name="AppearanceProtectionToggle" Grid.Column="1" Style="{StaticResource MasterSwitch}" VerticalAlignment="Top" HorizontalAlignment="Right" IsEnabled="{Binding IsChecked, ElementName=EnabledToggle}" AutomationProperties.Name="형태 변화 보호"/>
            </Grid>
          </Border>
          <TextBlock x:Name="EnhancementHint" Text="각각 따로 선택할 수 있습니다. 둘 다 끄면 기본 ×2 보간만 사용합니다. 형태 변화 보호만 켜도 GPU로 움직임을 분석합니다." Style="{StaticResource Subtle}"/>
          </StackPanel>
        </StackPanel>
      </TabItem>
      <TabItem x:Name="SetupTab" Header="연결 설정">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextElement.Foreground="{StaticResource Ink}" TextElement.FontWeight="Normal">
          <StackPanel>
            <TextBlock Text="처음 한 번만 연결하면 됩니다." FontWeight="SemiBold" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,10"><Button x:Name="RegisterButton" Content="필터 등록" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button x:Name="LaunchButton" Content="팟플레이어 열기"/></WrapPanel>
            <TextBlock x:Name="RegisterNotice" Style="{StaticResource Subtle}" Margin="0,0,0,14"/>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,0,0,14" Padding="0,12,0,0">
              <StackPanel>
                <WrapPanel><Button x:Name="InstallFolderButton" Content="설치 폴더 열기" Margin="0,0,8,8"/><Button x:Name="UninstallButton" Content="프로그램 제거" Margin="0,0,0,8"/></WrapPanel>
                <TextBlock Text="제거 전 팟플레이어를 닫아 주세요. 관리자용 필터가 있으면 Windows 권한 승인이 필요합니다." Style="{StaticResource Subtle}"/>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Subtle}" Text="팟플레이어 F5 → 코덱/필터 → 전역 필터 우선 순위에서 NVIDIA Optical Flow for PotPlayer를 추가하고, 최우선 사용을 선택하세요."/>
            <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,0" Text="다른 보간 필터는 함께 연결하지 마세요."/>
            <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,0" Text="필터를 더블클릭한 뒤 설정 창 열기를 누르면 이 설정창을 다시 열 수 있습니다."/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="DiagnosticsTab" Header="진단">
        <Grid TextElement.Foreground="{StaticResource Ink}" TextElement.FontWeight="Normal"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBox x:Name="DiagnosticsText" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{StaticResource SecondaryInk}" FontSize="12" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="현재 필터 진단 정보"/>
          <WrapPanel Grid.Row="1" Margin="0,10,0,0"><Button x:Name="LogButton" Content="진단 폴더 열기" Margin="0,0,8,0"/><Button x:Name="CopyButton" Content="정보 복사"/></WrapPanel>
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#F0F2EF" Padding="18,10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="SaveNotice" Text="변경 사항은 영상을 다시 열면 적용됩니다." Style="{StaticResource Subtle}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        <Button x:Name="CloseButton" Grid.Column="2" Content="닫기" MinWidth="72" IsCancel="True"/>
      </Grid>
    </Border>
  </Grid>
</Window>
