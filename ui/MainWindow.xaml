<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NVIDIA Optical Flow · PotPlayer" Width="520" Height="540" MinWidth="480" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="White" Foreground="#202A25"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#202A25"/>
    <SolidColorBrush x:Key="SecondaryInk" Color="#5D6962"/>
    <SolidColorBrush x:Key="Line" Color="#D5DDD8"/>
    <SolidColorBrush x:Key="Divider" Color="#E7ECE9"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="QuietSurface" Color="#F3F6F4"/>
    <SolidColorBrush x:Key="Accent" Color="#216D4C"/>
    <SolidColorBrush x:Key="AccentHover" Color="#18553B"/>
    <SolidColorBrush x:Key="Selected" Color="#EAF3ED"/>
    <SolidColorBrush x:Key="Error" Color="#A12D2D"/>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Background" Value="#B4C2BA"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
        <Border Background="Transparent" Padding="3,0"><Border x:Name="Grip" Background="{TemplateBinding Background}" CornerRadius="3" MinHeight="24"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#7C9385"/></Trigger>
          <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource Accent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}" Margin="0,3">
          <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Subtle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SecondaryInk}"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="18"/>
    </Style>
    <Style x:Key="FocusVisual">
      <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
        <Border Margin="-3" BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="8"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Authored WPF templates: shadcn's primary / outline / ghost hierarchy. -->
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="14,6"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0F4F1"/><Setter Property="BorderBrush" Value="#AFBEB4"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#E5ECE7"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHover}"/><Setter Property="BorderBrush" Value="{StaticResource AccentHover}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#10462F"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource SecondaryInk}"/><Setter Property="FontWeight" Value="Normal"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="RateCheck" TargetType="CheckBox">
      <Setter Property="Height" Value="32"/><Setter Property="Foreground" Value="{StaticResource SecondaryInk}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="Chrome" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
          <Grid>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
            <Border x:Name="SelectionMark" Width="12" Height="2" CornerRadius="1" Background="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" Visibility="Hidden"/>
            <Border x:Name="FocusBorder" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Margin="3"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="Tag" Value="First"><Setter TargetName="Chrome" Property="CornerRadius" Value="6,0,0,6"/></Trigger>
          <Trigger Property="Tag" Value="Last"><Setter TargetName="Chrome" Property="CornerRadius" Value="0,6,6,0"/><Setter TargetName="Chrome" Property="BorderThickness" Value="0"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Selected}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="SelectionMark" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DEEDE3"/></Trigger>
          <Trigger Property="IsFocused" Value="True"><Setter TargetName="FocusBorder" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="20,8"/><Setter Property="Foreground" Value="{StaticResource SecondaryInk}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
          <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="White"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
        <Grid KeyboardNavigation.TabNavigation="Local"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <Border Background="{StaticResource QuietSurface}" CornerRadius="8" Padding="3" Margin="20,0"><UniformGrid Rows="1" IsItemsHost="True"/></Border>
          <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="20,16,20,12"/>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MasterSwitch" TargetType="ToggleButton">
      <Setter Property="Width" Value="94"/><Setter Property="Height" Value="32"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="AutomationProperties.Name" Value="NVIDIA Optical Flow 사용"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border Background="Transparent" Padding="6,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Label" Text="꺼짐" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
            <Border x:Name="Track" Grid.Column="1" Height="22" CornerRadius="11" Background="#77867D" VerticalAlignment="Center"><Ellipse x:Name="Thumb" Fill="White" Width="16" Height="16" Margin="3" HorizontalAlignment="Left"/></Border>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Label" Property="Text" Value="켜짐"/><Setter TargetName="Label" Property="Foreground" Value="{StaticResource Accent}"/><Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.85"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FpsChoice" TargetType="RadioButton">
      <Setter Property="Height" Value="34"/><Setter Property="Foreground" Value="{StaticResource SecondaryInk}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="10,4" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E5ECE7"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="White"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
          <Trigger Property="IsFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SelectItem" TargetType="ComboBoxItem">
      <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="ItemChrome" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center"/>
            <Path x:Name="Check" Grid.Column="1" Data="M 1,6 L 4.5,9.5 L 11,2" Width="12" Height="12" Stroke="{StaticResource Accent}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Hidden"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource Selected}"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#DEEDE3"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="OutputSelect" TargetType="ComboBox">
      <Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="12,6"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MaxDropDownHeight" Value="280"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource SelectItem}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"/>
          <ToggleButton x:Name="DropDownToggle" Focusable="False" IsTabStop="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path Data="M 1,2 L 5,6 L 9,2" Width="10" Height="8" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Stroke="{StaticResource SecondaryInk}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,4,36,4" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="5" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
            <Border x:Name="MenuSurface" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
              <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" Focusable="False">
                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
              </ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#92AA9C"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Background="{StaticResource Surface}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="20,14,20,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="프레임 보간" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <ToggleButton x:Name="EnabledToggle" Grid.Column="1" Style="{StaticResource MasterSwitch}"/>
      </Grid>
      <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#717C74" Margin="0,0,7,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusTitle" Grid.Column="1" Text="팟플레이어 연결 대기" FontSize="13" AutomationProperties.LiveSetting="Polite"/>
      </Grid>
      <TextBlock x:Name="StatusDetail" Text="필터를 연결한 뒤 영상을 재생하면 상태가 표시됩니다." Style="{StaticResource Subtle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="13,3,0,0"/>
    </StackPanel>
    <TabControl x:Name="SettingsTabs" Grid.Row="1" SelectedIndex="0" KeyboardNavigation.TabNavigation="Continue">
      <TabItem x:Name="InterpolationTab" Header="보간 설정">
        <StackPanel x:Name="InterpolationPanel" TextElement.Foreground="{StaticResource Ink}" TextElement.FontWeight="Normal">
          <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="보간할 원본 FPS" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="여러 개 선택" Style="{StaticResource Subtle}"/>
          </Grid>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Background="White">
          <UniformGrid x:Name="InputRateChoices" Rows="1" Columns="6" IsEnabled="{Binding IsChecked, ElementName=EnabledToggle}" KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="보간할 원본 프레임, 여러 개 선택 가능">
            <CheckBox x:Name="InputRate0" Tag="First" Content="24" Style="{StaticResource RateCheck}" ToolTip="23.976 및 24 fps" AutomationProperties.Name="원본 24 fps 보간, 23.976 포함"/>
            <CheckBox x:Name="InputRate1" Content="25" Style="{StaticResource RateCheck}" AutomationProperties.Name="원본 25 fps 보간"/>
            <CheckBox x:Name="InputRate2" Content="30" Style="{StaticResource RateCheck}" ToolTip="29.97 및 30 fps" AutomationProperties.Name="원본 30 fps 보간, 29.97 포함"/>
            <CheckBox x:Name="InputRate3" Content="50" Style="{StaticResource RateCheck}" AutomationProperties.Name="원본 50 fps 보간"/>
            <CheckBox x:Name="InputRate4" Content="60" Style="{StaticResource RateCheck}" ToolTip="59.94 및 60 fps" AutomationProperties.Name="원본 60 fps 보간, 59.94 포함"/>
            <CheckBox x:Name="InputRate5" Tag="Last" Content="기타" Style="{StaticResource RateCheck}" ToolTip="목록에 없는 원본 FPS" AutomationProperties.Name="기타 원본 프레임 보간"/>
          </UniformGrid>
          </Border>
          <TextBlock x:Name="RateSelectionHint" Text="23.976 → 24 · 29.97 → 30 · 59.94 → 60에 포함" Style="{StaticResource Subtle}" Margin="0,6,0,10"/>
          <StackPanel Margin="0,0,0,12">
            <TextBlock Text="세로 해상도" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border IsEnabled="{Binding IsChecked, ElementName=EnabledToggle}" Background="{StaticResource QuietSurface}" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="8" Padding="3" ToolTip="선택한 세로 해상도를 넘는 영상은 원본 FPS로 재생합니다.">
              <UniformGrid Rows="1" Columns="3">
                <RadioButton x:Name="HeightAll" Content="전체" GroupName="Height" Style="{StaticResource FpsChoice}" AutomationProperties.Name="세로 해상도 전체 보간"/>
                <RadioButton x:Name="Height1080" Content="1080p 이하" GroupName="Height" Style="{StaticResource FpsChoice}" AutomationProperties.Name="세로 해상도 1080p 이하 보간"/>
                <RadioButton x:Name="Height1440" Content="1440p 이하" GroupName="Height" Style="{StaticResource FpsChoice}" AutomationProperties.Name="세로 해상도 1440p 이하 보간"/>
              </UniformGrid>
            </Border>
          </StackPanel>
          <Grid IsEnabled="{Binding IsChecked, ElementName=EnabledToggle}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="OutputRateSummary" Text="출력 방식" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock x:Name="OutputValueLabel" Grid.Column="2" Text="FPS 상한" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox x:Name="OutputModeChoice" Grid.Row="1" Style="{StaticResource OutputSelect}" AutomationProperties.LabeledBy="{Binding ElementName=OutputRateSummary}">
              <ComboBoxItem Content="FPS 상한"/>
              <ComboBoxItem Content="원본 배수"/>
              <ComboBoxItem Content="해상도별 설정"/>
            </ComboBox>
            <ComboBox x:Name="OutputValueChoice" Grid.Row="1" Grid.Column="2" Style="{StaticResource OutputSelect}" AutomationProperties.LabeledBy="{Binding ElementName=OutputValueLabel}"/>
            <Button x:Name="ResolutionEditButton" Grid.Row="1" Grid.Column="2" Content="해상도별 편집…" Visibility="Collapsed" MinHeight="38" AutomationProperties.Name="해상도별 출력 설정 편집"/>
          </Grid>
          <TextBlock x:Name="OutputRateHint" Style="{StaticResource Subtle}" Margin="0,4,0,0"/>
        </StackPanel>
      </TabItem>
      <TabItem x:Name="SetupTab" Header="연결 설정">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextElement.Foreground="{StaticResource Ink}" TextElement.FontWeight="Normal">
          <StackPanel>
            <TextBlock Text="현재 폴더의 필터를 연결합니다." FontWeight="SemiBold" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,10"><Button x:Name="RegisterButton" Content="필터 등록" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button x:Name="LaunchButton" Content="팟플레이어 열기"/></WrapPanel>
            <TextBlock x:Name="RegisterNotice" Style="{StaticResource Subtle}" Margin="0,0,0,14"/>
            <TextBlock Style="{StaticResource Subtle}" Text="팟플레이어 F5 → 코덱/필터 → 전역 필터 우선 순위에서 NVIDIA Optical Flow for PotPlayer를 추가하고 ‘최우선 사용’을 선택하세요."/>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
              <StackPanel>
                <WrapPanel><Button x:Name="InstallFolderButton" Content="현재 폴더 열기" Margin="0,0,8,8"/><Button x:Name="UnregisterButton" Content="필터 등록 해제" Margin="0,0,8,8"/><Button x:Name="UninstallButton" Content="프로그램 제거" Visibility="Collapsed" Margin="0,0,0,8"/></WrapPanel>
                <TextBlock x:Name="PackageHint" Style="{StaticResource Subtle}" Text="폴더를 옮기거나 삭제하기 전, 팟플레이어를 닫고 등록을 해제하세요. 옮긴 폴더에서는 다시 등록하면 됩니다."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="DiagnosticsTab" Header="진단">
        <Grid TextElement.Foreground="{StaticResource Ink}" TextElement.FontWeight="Normal"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBox x:Name="DiagnosticsText" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{StaticResource SecondaryInk}" FontSize="12" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="현재 필터 진단 정보"/>
          <WrapPanel Grid.Row="1" Margin="0,10,0,0"><Button x:Name="LogButton" Content="진단 폴더 열기" Margin="0,0,8,0"/><Button x:Name="CopyButton" Content="정보 복사"/></WrapPanel>
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Background="{StaticResource QuietSurface}" Padding="20,10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="SaveNotice" Text="변경 사항은 영상을 다시 열면 적용됩니다." Style="{StaticResource Subtle}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        <Button x:Name="CloseButton" Grid.Column="2" Content="닫기" MinWidth="72" IsCancel="True"/>
      </Grid>
    </Border>
  </Grid>
</Window>
