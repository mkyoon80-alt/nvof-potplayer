NVOF_TUNABLE(evidence_photo_high, 40, 1.0, 80.0, "evidence", "8bit_level", "Photometric mismatch where evidence reaches zero")
NVOF_TUNABLE(warp_photo_scale, 24, 1.0, 48.0, "warp", "8bit_level", "Mismatch scale for geometric prior attenuation")
NVOF_TUNABLE(warp_expansion_start, 2.5, 1.0, 4.0, "warp", "jacobian", "Area expansion where stretch attenuation starts")
