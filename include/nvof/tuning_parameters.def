// Single source for C++, HLSL and the Python controller. Keep groups of four floats.
// name, default, minimum, maximum, group, unit, description
NVOF_TUNABLE(repair_min_motion, 32.0, 8.0, 128.0, "repair", "analysis_px", "Minimum displacement for first-pass donor repair")
NVOF_TUNABLE(repair_propagation_min_motion, 64.0, 8.0, 256.0, "repair", "analysis_px", "Minimum displacement for second-pass propagation")
NVOF_TUNABLE(repair_photo_max, 12.0, 1.0, 40.0, "repair", "8bit_level", "Maximum donor photometric error")
NVOF_TUNABLE(repair_improvement_ratio, 0.6, 0.1, 0.95, "repair", "ratio", "Required relative improvement of donor cost")
NVOF_TUNABLE(pattern_min_motion, 32.0, 8.0, 128.0, "pattern", "analysis_px", "Minimum candidate speed for vertical repeated patterns")
NVOF_TUNABLE(pattern_donor_abs, 2.5, 0.1, 8.0, "pattern", "analysis_px", "Absolute tolerance between opposing donors")
NVOF_TUNABLE(pattern_donor_relative, 0.3, 0.01, 0.5, "pattern", "ratio", "Relative tolerance between opposing donors")
NVOF_TUNABLE(pattern_photo_max, 14, 1.0, 40.0, "pattern", "8bit_level", "Maximum wide-patch matching error")
NVOF_TUNABLE(pattern_improvement_ratio, 0.93, 0.1, 0.99, "pattern", "ratio", "Required relative wide-patch improvement")
NVOF_TUNABLE(pattern_improvement_margin, 0.5, 0.0, 10.0, "pattern", "8bit_level", "Required absolute wide-patch improvement")
NVOF_TUNABLE(near_static_photo_max, 3.0, 0.1, 12.0, "near_static", "8bit_level", "Maximum local translation mean error")
NVOF_TUNABLE(near_static_improvement_ratio, 0.35, 0.05, 0.9, "near_static", "ratio", "Required relative local translation improvement")
NVOF_TUNABLE(near_static_peak_max, 16.0, 1.0, 64.0, "near_static", "8bit_level", "Maximum local translation peak error")
NVOF_TUNABLE(glyph_photo_max, 10.0, 1.0, 32.0, "glyph", "8bit_level", "Maximum glyph alias candidate error")
NVOF_TUNABLE(glyph_improvement_ratio, 0.4, 0.1, 0.9, "glyph", "ratio", "Required relative glyph alias improvement")
NVOF_TUNABLE(stroke_photo_max, 3.0, 0.1, 12.0, "stroke", "8bit_level", "Maximum parallel stroke candidate error")
NVOF_TUNABLE(stroke_improvement_ratio, 0.4, 0.1, 0.9, "stroke", "ratio", "Required relative parallel stroke improvement")
NVOF_TUNABLE(evidence_fb_low, 0.2, 0.0, 4.0, "evidence", "analysis_px", "Forward/backward error where attenuation starts")
